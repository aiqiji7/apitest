# Local agent / browser debug dumps
.playwright-cli/
.omo/

# Dependencies (also covered under .opencode/.gitignore)
node_modules/

# Python cache (also covered under .trellis/.gitignore)
__pycache__/
*.py[cod]
*$py.class

# Editor / OS noise
.DS_Store
*~
*.swp
*.swo

# Ad-hoc local screenshots (keep tracked assets like example.png)
gpt-5.5.png

# Note: Trellis runtime/private state (.runtime/, .developer, .backup-*, etc.)
# lives in .trellis/.gitignore — do not ignore the whole .trellis/ tree.
